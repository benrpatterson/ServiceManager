<Window x:Class="ServiceManager.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Working..." Height="300" Width="460" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="ToolWindow" Closing="Window_Closing">
    <DockPanel Margin="14">
        <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ProgressBar x:Name="Bar" DockPanel.Dock="Top" Height="18" Margin="0,10,0,4" />
        <TextBlock x:Name="CountText" DockPanel.Dock="Top" Foreground="Gray" />
        <ListBox x:Name="Log" Margin="0,10,0,0" />
    </DockPanel>
</Window>
